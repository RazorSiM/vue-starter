{
  "name": "@razorsim/vue-starter",
  "type": "module",
  "version": "3.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11"
  },
  "repository": {
    "type": "git",
    "url": "github:razorsim/vue-starter"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint-vize --type-aware .",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run lint && pnpm run format:check && pnpm run type-check",
    "changelog": "changelogen",
    "release": "changelogen --release --clean --push",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@unhead/vue": "^3.2.3",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.3.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.120",
    "@playwright/test": "1.61.1",
    "@shikijs/markdown-it": "^4.3.1",
    "@tsconfig/node26": "^26.0.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "changelogen": "^0.6.2",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "oxfmt": "0.60.0",
    "oxlint": "~1.75.0",
    "oxlint-plugin-vize": "0.291.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "~6.0.3",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-turbo-console": "^2.3.3",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-markdown": "^32.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
