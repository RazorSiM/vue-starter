{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "tsconfig.json": "tsconfig.*.json, env.d.ts",
    "vite.config.*": "uno.config.*, playwright.config.*, lefthook.yaml",
    "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, .oxlintrc.json, .oxfmtrc.json, .editorconfig, .nvmrc, .gitattributes, devenv.nix, devenv.yaml, devenv.lock, .envrc"
  },

  // oxfmt is a real formatter, so format-on-save is correct now. The old setup
  // relied on ESLint's source.fixAll.eslint to do formatting instead.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },

  "oxc.enable": true,
  "oxc.lint.run": "onType",
  "oxc.configPath": ".oxlintrc.json",
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "oxc.tsConfigPath": "tsconfig.app.json",

  // Load-bearing, not decoration: without these a contributor with a global
  // Prettier default formatter double-formats these files.
  "[vue]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[markdown]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[yaml]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[html]": { "editor.defaultFormatter": "oxc.oxc-vscode" },

  "eslint.enable": false,
  "prettier.enable": false
}
